<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Weconnect" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="materialAlertDialogTheme">@style/Dialog.App</item>
    </style>

    <!-- Dialog theme: bo góc 20dp, font hệ thống -->
    <style name="Dialog.App" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.App</item>
        <item name="buttonBarNegativeButtonStyle">@style/Dialog.App.ButtonNegative</item>
        <item name="buttonBarPositiveButtonStyle">@style/Dialog.App.ButtonPositive</item>
        <item name="buttonBarNeutralButtonStyle">@style/Dialog.App.ButtonNeutral</item>
    </style>

    <!-- shapeAppearance đặt ở widget style, không phải theme overlay -->
    <style name="MaterialAlertDialog.App" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Dialog</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Dialog.App.ButtonPositive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary_pink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Dialog.App.ButtonNegative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary_pink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Dialog.App.ButtonNeutral" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TagCategoryHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8E8881</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="CustomChipChoice" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:checkable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="chipBackgroundColor">@color/chip_background_state</item>
        <item name="android:textColor">@color/chip_text_state</item>
        <item name="checkedIconVisible">true</item>
        <item name="checkedIcon">@drawable/ic_check</item>
        <item name="checkedIconTint">@android:color/white</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <style name="CustomChipGroupStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipSpacingHorizontal">8dp</item>
        <item name="chipSpacingVertical">8dp</item>
        <item name="singleSelection">true</item>
    </style>

    <style name="QuickParticipantChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:checkable">true</item>
        <item name="chipBackgroundColor">@color/chip_background_state</item>
        <item name="android:textColor">@color/chip_text_state</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <style name="ProfileInterestChip" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipBackgroundColor">@color/chip_background_state</item>
        <item name="android:textColor">@color/chip_text_state</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="closeIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
    </style>
        <dimen name="profile_interest_chip_radius">16dp</dimen>
    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="textAllCaps">false</item>
    </style>


</resources>