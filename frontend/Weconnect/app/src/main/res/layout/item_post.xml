<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Avatar + Name + Time + Menu -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvAvatarContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/post_item_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_user_placeholder" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/post_item_username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toTopOf="@id/post_item_time"
                app:layout_constraintEnd_toStartOf="@id/ivPostMenu"
                app:layout_constraintStart_toEndOf="@id/cvAvatarContainer"
                app:layout_constraintTop_toTopOf="@id/cvAvatarContainer"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="Tên người dùng" />

            <TextView
                android:id="@+id/post_item_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/cvAvatarContainer"
                app:layout_constraintStart_toEndOf="@id/cvAvatarContainer"
                app:layout_constraintTop_toBottomOf="@id/post_item_username"
                tools:text="2 giờ trước" />

            <ImageView
                android:id="@+id/ivPostMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_more"
                android:contentDescription="Menu bài viết"
                app:tint="@color/text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/cvAvatarContainer"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Content Text -->
        <TextView
            android:id="@+id/post_item_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            tools:text="Nội dung bài đăng sẽ hiển thị ở đây..." />

        <!-- Post Image (user-uploaded) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvPostImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/ivPostImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/post_item_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tag_shadow"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/primary_pink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:elevation="2dp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Đá bóng" />

        <TextView
            android:id="@+id/post_item_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="📍 Phường Phú Lương, Hà Đông, Hà Nội"
            tools:visibility="visible" />

        <!-- Time Range & Countdown -->
        <LinearLayout
            android:id="@+id/layoutTimeRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Row 1: date range + countdown badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/post_item_date_range"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="📅 Ngày: 14/05/2026 - 15/05/2026" />

                <TextView
                    android:id="@+id/post_item_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_selected_tag"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="⏰ Còn 2 giờ"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Row 2: daily time slot or continuous end time -->
            <TextView
                android:id="@+id/post_item_time_slot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="⏰ Mỗi ngày: 14:00 - 15:00"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Expiration Hours Display -->
        <TextView
            android:id="@+id/tvExpirationHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="⏳ Thời hạn bài viết: 48 giờ"
            tools:visibility="visible" />

        <!-- Stats Row Removed -->

        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#F0F0F0" android:layout_marginVertical="12dp"/>

        <!-- Group Action Buttons -->
        <!-- Group Action Buttons -->
        <!-- Active: Join + Members buttons -->
        <LinearLayout
            android:id="@+id/layoutActiveButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnJoinGroup"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_join"
                android:text="Tham gia nhóm"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnViewMembers"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="#FFFFFF"
                android:text="👥 0/0"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Expired: Closed label -->
        <TextView
            android:id="@+id/tvExpiredLabel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/background_soft"
            android:gravity="center"
            android:text="⏰ Bài viết đã hết hạn"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
