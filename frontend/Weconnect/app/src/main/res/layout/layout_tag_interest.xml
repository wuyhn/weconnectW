<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_beige"
    android:fitsSystemWindows="true">

    <View
        android:id="@+id/viewHandle"
        android:layout_width="45dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="#D1CAbF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header with close button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerInterest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/viewHandle">

        <ImageView
            android:id="@+id/ivCloseInterest"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_action_icon_circle"
            android:clickable="true"
            android:contentDescription="Đóng"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTagTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sở thích"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/dividerInterest"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E8E4DE"
        app:layout_constraintTop_toBottomOf="@id/headerInterest" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvInterestDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="Chọn sở thích phù hợp cho bài viết của bạn"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/dividerInterest" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvInterestDesc"
        app:layout_constraintBottom_toTopOf="@id/btnOkInterest">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Sport -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView style="@style/TagCategoryHeader" android:text="Vận động &amp; Thể thao" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/groupSport"
                        style="@style/CustomChipGroupStyle"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false">
                        <com.google.android.material.chip.Chip style="@style/CustomChipChoice" android:text="Đá bóng" />
                        <com.google.android.material.chip.Chip style="@style/CustomChipChoice" android:text="Cầu lông" />
                        <com.google.android.material.chip.Chip style="@style/CustomChipChoice" android:text="Chạy bộ" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Study -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView style="@style/TagCategoryHeader" android:text="Học tập &amp; Công việc" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/groupStudy"
                        style="@style/CustomChipGroupStyle"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.chip.Chip style="@style/CustomChipChoice" android:text="Học bài" />
                        <com.google.android.material.chip.Chip style="@style/CustomChipChoice" android:text="Học Tiếng Anh" />
                        <com.google.android.material.chip.Chip style="@style/CustomChipChoice" android:text="Đồ họa / Code" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chill -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView style="@style/TagCategoryHeader" android:text="Thư giãn &amp; Giải trí" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/groupChill"
                        style="@style/CustomChipGroupStyle"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.chip.Chip style="@style/CustomChipChoice" android:text="Đi Cafe" />
                        <com.google.android.material.chip.Chip style="@style/CustomChipChoice" android:text="Xem phim" />
                        <com.google.android.material.chip.Chip style="@style/CustomChipChoice" android:text="Chơi Game" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOkInterest"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="Xác nhận"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_pink"
        app:cornerRadius="28dp"
        app:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
