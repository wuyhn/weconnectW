<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@null"
    android:fitsSystemWindows="true">

    <!-- Handle bar -->
    <View
        android:id="@+id/viewHandleParticipant"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:layout_gravity="center_horizontal"
        android:background="#D1D1D6" />

    <!-- Header -->
    <FrameLayout
        android:id="@+id/headerParticipant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvParticipantTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Số người tham gia"
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Keep ID for Java compatibility, but hidden -->
        <ImageView
            android:id="@+id/ivCloseParticipant"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:id="@+id/dividerParticipant"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#D1D1D6" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollParticipantContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvParticipantDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Nhập số lượng người tham gia tối đa"
                android:textColor="#1C1C1E"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvParticipantSubDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Số này sẽ hiển thị ở nút xem thành viên sau khi đăng bài"
                android:textColor="#8E8E93"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilParticipantLimit"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#007AFF"
                app:hintEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etParticipantLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ví dụ: 10"
                    android:inputType="number"
                    android:maxLines="1"
                    android:paddingVertical="14dp"
                    android:textColor="#1C1C1E"
                    android:textColorHint="#8E8E93"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Chọn nhanh"
                android:textColor="#8E8E93"
                android:textSize="13sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupQuickParticipant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:singleLine="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipParticipant5"
                    style="@style/QuickParticipantChip"
                    android:text="5 người" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipParticipant10"
                    style="@style/QuickParticipantChip"
                    android:text="10 người" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipParticipant20"
                    style="@style/QuickParticipantChip"
                    android:text="20 người" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipParticipant50"
                    style="@style/QuickParticipantChip"
                    android:text="50 người" />
            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOkParticipant"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="Xác nhận"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_pink"
        app:cornerRadius="26dp"
        app:elevation="0dp" />

</LinearLayout>
