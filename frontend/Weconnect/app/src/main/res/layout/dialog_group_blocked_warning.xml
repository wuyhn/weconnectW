<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_dark_rounded"
    android:orientation="vertical">

    <!-- Close button row -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp">

        <!-- ImageView thay ImageButton để tránh linter auto-resize minHeight -->
        <ImageView
            android:id="@+id/btnCloseBlockedWarning"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_close_btn_dark"
            android:clickable="true"
            android:contentDescription="Đóng"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_close"
            app:tint="#333333" />
    </FrameLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Avatar cluster: back-to-front (last child = top z-order) -->
        <FrameLayout
            android:id="@+id/avatarCluster"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp">

            <!-- Avatar 3 (back layer, rightmost) -->
            <FrameLayout
                android:id="@+id/frameAvatar3"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="40dp"
                android:background="@drawable/bg_avatar_dark_border"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/ivAvatar3"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user_placeholder" />
                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_block_badge_red"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_block"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <!-- Avatar 2 (middle layer) -->
            <FrameLayout
                android:id="@+id/frameAvatar2"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_avatar_dark_border"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/ivAvatar2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user_placeholder" />
                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_block_badge_red"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_block"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <!-- Avatar 1 (front layer, leftmost, drawn on top) -->
            <FrameLayout
                android:id="@+id/frameAvatar1"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_avatar_dark_border"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/ivAvatar1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user_placeholder" />
                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_block_badge_red"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_block"
                    app:tint="#FFFFFF" />
            </FrameLayout>

        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvBlockedWarningTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Người này sẽ vẫn bị chặn dù tham gia đoạn chat. Hệ thống sẽ ẩn tin nhắn của họ để bảo vệ bạn."
            android:textColor="#555555"
            android:textSize="14sp" />

        <!-- Link -->
        <TextView
            android:id="@+id/tvViewBlockedLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Xem người bạn đã chặn"
            android:textColor="#005BBB"
            android:textSize="14sp" />

        <!-- Button: Ở lại đoạn chat -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStayInChat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="Ở lại đoạn chat"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            app:backgroundTint="#F0F0F0"
            app:cornerRadius="14dp"
            app:elevation="0dp" />

        <!-- Button: Rời khỏi đoạn chat -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeaveChat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="Rời khỏi đoạn chat"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            app:backgroundTint="#F0F0F0"
            app:cornerRadius="14dp"
            app:elevation="0dp" />

    </LinearLayout>
</LinearLayout>
